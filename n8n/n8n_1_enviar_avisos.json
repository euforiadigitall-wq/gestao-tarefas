    {
      "id": "fe9d94b6-6b7f-4733-a815-feba2a7109c7",
      "name": "Buscar avisos pendentes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.supabase_url }}/rest/v1/notificacoes",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "enviada_em",
              "value": "is.null"
            },
            {
              "name": "tentativas",
              "value": "lt.5"
            },
            {
              "name": "select",
              "value": "id,tipo,assunto,dados,tentativas,pessoa:pessoas(nome,email)"
            },
            {
              "name": "order",
              "value": "criada_em.asc"
            },
            {
              "name": "limit",
              "value": "40"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $json.service_key }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.service_key }}"
            },
            {
              "name": "Accept-Profile",
              "value": "gestao"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a40375e3-f274-4be9-9d1f-0233a82ec756",
      "name": "Montar e-mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const n = $json;\nconst cfg = $('Config').first().json;\nconst esc = (t) => String(t ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/\\n/g,'<br>');\nconst dia = (d) => { if (!d) return ''; const p = String(d).slice(0,10).split('-'); return p.length === 3 ? `${p[2]}/${p[1]}` : ''; };\nconst d = n.dados || {};\nconst pessoa = n.pessoa || {};\nconst nome = String(pessoa.nome || '').split(' ')[0] || 'Oi';\n\nconst linha = (rotulo, valor) => valor ? `<tr><td style=\"padding:2px 12px 2px 0;color:#6b7280\">${rotulo}</td><td style=\"padding:2px 0\"><b>${esc(valor)}</b></td></tr>` : '';\nlet corpo = '';\n\nif (n.tipo === 'resumo_diario') {\n  const lista = (itens) => (itens || []).map(i =>\n    `<li style=\"margin:0 0 8px 0\"><b>${esc(i.titulo)}</b>${i.cliente ? ' (' + esc(i.cliente) + ')' : ''}${i.acao ? '<br><span style=\"color:#6b7280\">' + esc(i.acao) + ' · prazo ' + dia(i.prazo) + '</span>' : '<br><span style=\"color:#6b7280\">prazo ' + dia(i.prazo) + '</span>'}</li>`).join('');\n  if ((d.atrasadas || []).length) corpo += `<h3 style=\"margin:16px 0 8px;color:#b91c1c\">Atrasadas (${d.atrasadas.length})</h3><ul style=\"padding-left:18px;margin:0\">${lista(d.atrasadas)}</ul>`;\n  if ((d.hoje || []).length) corpo += `<h3 style=\"margin:16px 0 8px\">Para hoje (${d.hoje.length})</h3><ul style=\"padding-left:18px;margin:0\">${lista(d.hoje)}</ul>`;\n} else if (n.tipo === 'mencao' || n.tipo === 'comentario') {\n  corpo = `<p style=\"margin:0 0 8px\">${esc(d.por || 'Alguém')} ${n.tipo === 'mencao' ? 'mencionou você' : 'comentou'} em <b>${esc(d.titulo)}</b>:</p>` +\n          `<blockquote style=\"margin:8px 0;padding:8px 12px;border-left:3px solid #c9a24d;background:#faf7ef\">${esc(d.texto)}</blockquote>`;\n} else {\n  const intro = {\n    atribuida: 'Uma tarefa nova ficou com você.',\n    reatribuida: `${esc(d.por || 'Alguém')} passou esta tarefa para você.`,\n    na_sua_etapa: 'Uma peça chegou na sua etapa.',\n    devolvida: `${esc(d.por || 'Alguém')} devolveu esta peça para você.`,\n  }[n.tipo] || '';\n  corpo = `<p style=\"margin:0 0 10px\">${intro}</p><table style=\"border-collapse:collapse\">` +\n    linha('Tarefa', d.titulo) + linha('Cliente', d.cliente) + linha('Situação', d.estado) +\n    linha('Sua ação', d.proxima_acao) + linha('Prazo', dia(d.prazo)) + `</table>`;\n  if (n.tipo === 'devolvida' && d.motivo) {\n    corpo += `<p style=\"margin:12px 0 4px\"><b>Motivo da devolução</b></p><blockquote style=\"margin:0;padding:8px 12px;border-left:3px solid #b91c1c;background:#fdf2f2\">${esc(d.motivo)}</blockquote>`;\n  }\n}\n\nconst botao = cfg.app_url ? `<p style=\"margin:20px 0 0\"><a href=\"${esc(cfg.app_url)}\" style=\"background:#0f1b3d;color:#fff;padding:10px 18px;border-radius:6px;text-decoration:none\">Abrir o sistema</a></p>` : '';\nconst html = `<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;color:#111827;max-width:560px\">` +\n  `<p style=\"margin:0 0 12px\">Oi, ${esc(nome)}.</p>${corpo}${botao}` +\n  `<p style=\"margin:24px 0 0;color:#9ca3af;font-size:12px\">Aviso automático do sistema de tarefas da EuforIA. Você liga ou desliga estes avisos no seu perfil.</p></div>`;\n\nreturn { json: { notif_id: n.id, tentativas: n.tentativas || 0, to: pessoa.email || '', subject: n.assunto, html } };"
      }
    },
    {
      "id": "f61cc330-d227-4962-835b-a28670074423",
      "name": "Enviar pelo Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.resend_key }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.notif_id }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: $('Config').first().json.remetente, to: [$json.to], subject: $json.subject, html: $json.html, reply_to: $('Config').first().json.responder_para || undefined }) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 600
            }
          }
        }
      }
    },
